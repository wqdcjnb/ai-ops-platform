# Copy this file to .env before starting Docker Compose.
# Never commit the copied .env file or real credentials.
# Docker's local single-admin mode creates the session automatically; no
# administrator password is needed or read in this mode.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_DISPLAY_NAME=超级管理员

# Keep false for the current empty business database; set true only when demo data is needed.
AI_OPS_SEED_DEMO_DATA=false
AI_OPS_ADMIN_ONLY=true
AI_OPS_SOFT_QUOTA_ENABLED=false

# Leave the gateway unconfigured until a real upstream is intentionally connected.
AI_OPS_GATEWAY_MODE=standalone
AI_OPS_GATEWAY_PROVIDER=openai_compatible
AI_OPS_GATEWAY_UPSTREAM_BASE_URL=
AI_OPS_GATEWAY_UPSTREAM_API_KEY=
AI_OPS_GATEWAY_NEW_API_BASE_URL=
AI_OPS_GATEWAY_NEW_API_API_KEY=
AI_OPS_GATEWAY_CPA_BASE_URL=
AI_OPS_GATEWAY_CPA_API_KEY=
AI_OPS_GATEWAY_DEFAULT_MODEL=
AI_OPS_GATEWAY_FALLBACK_MODEL=
AI_OPS_GATEWAY_ALLOW_FALLBACK=false
AI_OPS_GATEWAY_CLIENT_API_KEY=
AI_OPS_GATEWAY_MODEL_ALIASES=

# If New API runs on the host, use http://host.docker.internal:3000 from the container.
NEW_API_BASE_URL=
NEW_API_ACCESS_TOKEN=
