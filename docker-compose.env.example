# This file is copied to .env by start-docker.cmd. Do not commit the copy.
# CPA config/auths and New API SQLite data are kept under deploy/ and are
# already mounted by the project Compose file.

AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_DISPLAY_NAME=超级管理员
AI_OPS_SEED_DEMO_DATA=false
AI_OPS_ADMIN_ONLY=true
AI_OPS_SOFT_QUOTA_ENABLED=false
AI_OPS_UPSTREAM_PRIMARY=true
# Unified entry Docker status/restart controls. Set false for a read-only
# dashboard; the Compose file mounts the Engine socket only for the server.
AI_OPS_DOCKER_CONTROL=true
COMPOSE_PROJECT_NAME=ai-ops-platform

# The Compose topology is fixed to the in-project service names cpa and
# new-api. The URL values below document the internal endpoints.
CPA_IMAGE=eceasy/cli-proxy-api:latest
NEW_API_IMAGE=calciumion/new-api:latest
AI_OPS_GATEWAY_MODE=new_api
AI_OPS_GATEWAY_CPA_BASE_URL=http://cpa:8317/v1
AI_OPS_GATEWAY_NEW_API_BASE_URL=http://new-api:3000/v1
# Host-visible direct New API endpoint (management/diagnostics only).
AI_OPS_PUBLIC_NEW_API_BASE_URL=http://127.0.0.1:3000/v1
# Host-visible AI OPS gateway endpoint used in exported WorkBuddy/Codex
# configurations. Requests must enter here for conversation body capture.
AI_OPS_PUBLIC_GATEWAY_BASE_URL=http://127.0.0.1:4175/v1
CPA_MANAGEMENT_URL=http://cpa:8317/management.html

# New API's existing SQLite database is migrated into deploy/new-api/data.
# Set these only if AI OPS should call New API's protected management/catalog
# endpoints. They remain local configuration and are never committed.
NEW_API_ACCESS_TOKEN=
NEW_API_USER_ID=
AI_OPS_GATEWAY_NEW_API_API_KEY=
# In Compose this is set to /app/runtime/new-api/data/new-api.db and mounted
# read-only from deploy/new-api/data. Set the equivalent local path for a
# non-Compose server process.
NEW_API_DB_PATH=

# The server reads only request metadata from CPA main.log; bodies and error
# files are never parsed. Compose supplies /app/runtime/cpa/logs automatically.
CPA_LOG_PATH=/app/runtime/cpa/logs

# AI OPS client key for employee clients; this is not the CPA management key.
AI_OPS_GATEWAY_CLIENT_API_KEY=
AI_OPS_GATEWAY_MODEL_ALIASES=
AI_OPS_GATEWAY_TIMEOUT_MS=180000
AI_OPS_GATEWAY_ALLOW_FALLBACK=false

# Stable secret used to encrypt AI OPS Key values at rest.
AI_OPS_KEY_ENCRYPTION_SECRET=change-this-local-encryption-secret
AI_OPS_AUDIT_ENCRYPTION_SECRET=change-this-local-audit-encryption-secret
