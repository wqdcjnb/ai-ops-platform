# This file is a reference only. On Windows, double-click start-docker.cmd:
# it creates a real .env with fresh secrets and a bootstrap administrator.
# Never commit or send the generated .env to another person.
COMPOSE_PROJECT_NAME=ai-ops-platform

# Local-only is the safe default. For a trusted LAN, set 0.0.0.0 and change
# the gateway URL below to the server's stable LAN IP or domain.
AI_OPS_BIND_ADDRESS=127.0.0.1
AI_OPS_WEB_PORT=4174
AI_OPS_GATEWAY_PORT=4175

AUTH_ADMIN_USERNAME=admin@aiops.local
AUTH_ADMIN_PASSWORD=replace-with-a-long-local-admin-password
AUTH_ADMIN_DISPLAY_NAME=超级管理员
AI_OPS_KEY_ENCRYPTION_SECRET=replace-with-a-long-random-local-secret
AI_OPS_AUDIT_ENCRYPTION_SECRET=replace-with-a-second-long-random-local-secret

# Host-visible gateway URL. It is written into employee Codex /
# WorkBuddy configuration. Use HTTPS before exposing this service publicly.
AI_OPS_PUBLIC_GATEWAY_BASE_URL=http://127.0.0.1:4175
AI_OPS_GATEWAY_MODE=relay
AI_OPS_GATEWAY_TIMEOUT_MS=60000
AI_OPS_GATEWAY_DEFAULT_STREAMING=false
AI_OPS_CONTEXT_OPTIMIZATION_ENABLED=true
AI_OPS_CONTEXT_MAX_INPUT_CHARS=48000
AI_OPS_CONTEXT_MAX_MESSAGES=24
AI_OPS_RELAY_PROBE_FANOUT=3

# Optional exact hostnames for a stricter third-party-service restriction.
# Leave blank to allow public HTTPS services configured by the super administrator.
AI_OPS_EXTERNAL_PROVIDER_ALLOWED_HOSTS=
AI_OPS_ALLOW_INSECURE_EXTERNAL_PROVIDER=false
