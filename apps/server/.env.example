# Save local settings as apps/server/.env.local (ignored by Git).
# Both dev and start load .env.local; existing process environment takes precedence.
# New API is probed on the server only. Never expose these values to the browser.
NEW_API_BASE_URL=http://127.0.0.1:3000
# Public OpenAI-compatible endpoint written to employee client configs.
# Client exports must use the AI OPS gateway so conversation bodies are
# captured before forwarding to New API.
AI_OPS_PUBLIC_GATEWAY_BASE_URL=http://127.0.0.1:4175/v1
AI_OPS_PUBLIC_NEW_API_BASE_URL=http://127.0.0.1:3000/v1

# Optional management credential. Leave blank to report connectivity only.
NEW_API_ACCESS_TOKEN=

# Optional read-only path to New API's SQLite database. When configured, users,
# Tokens, models and channels are read from this database as the primary source.
NEW_API_DB_PATH=../../deploy/new-api/data/new-api.db

# Optional read-only CPA runtime log directory. Only main.log request metadata
# is parsed; request/response bodies and error files are never read.
CPA_LOG_PATH=../../deploy/cpa/logs

# Optional compatibility header for older New API deployments.
NEW_API_USER_ID=

# Authentication is required by default. Use disabled only for isolated contract tests.
AUTH_MODE=required
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_DISPLAY_NAME=超级管理员
# AUTH_ADMIN_PASSWORD is only a legacy compatibility setting when
# AI_OPS_ADMIN_ONLY=false; single-admin mode never reads or asks for it.
AUTH_EMPLOYEE_USERNAME=employee
AUTH_EMPLOYEE_PASSWORD=change-this-employee-password
AUTH_EMPLOYEE_DISPLAY_NAME=林筱雨

# SQLite path. Leave blank to use data/platform.sqlite under the server workspace.
PLATFORM_DB_PATH=
# Encrypts locally stored Key values used by the super-admin "查看完整 Key" action.
# Set a stable random value before sharing or backing up the SQLite database.
AI_OPS_KEY_ENCRYPTION_SECRET=change-this-local-encryption-secret
# Stable secret used to encrypt captured Prompt/reply bodies at rest.
# Keep this separate from the Key secret in production.
AI_OPS_AUDIT_ENCRYPTION_SECRET=change-this-local-audit-encryption-secret

# Set to false for an empty local business database. Local admin/employee login accounts remain available.
AI_OPS_SEED_DEMO_DATA=true
# Set to true for a local admin-only console; employee login is disabled and not seeded.
AI_OPS_ADMIN_ONLY=false
# When true, the local web console automatically bootstraps this server-side
# admin identity and does not show a login page. Keep the BFF bound to localhost.
# Set to false to remove legacy soft-quota targets, temporary quota workflows,
# from the local console. Hard rate-limit observation remains separate.
AI_OPS_SOFT_QUOTA_ENABLED=true
AI_OPS_UPSTREAM_PRIMARY=false

# Production traffic uses New API as the employee-facing gateway. CPA is the
# separate OAuth account-pool source configured alongside it.
AI_OPS_GATEWAY_MODE=new_api
# Supported standalone providers: openai_compatible, ollama.
AI_OPS_GATEWAY_PROVIDER=openai_compatible
# Leave blank until a real upstream is intentionally configured.
AI_OPS_GATEWAY_UPSTREAM_BASE_URL=
AI_OPS_GATEWAY_UPSTREAM_API_KEY=
# Connector-specific OpenAI-compatible /v1 endpoints. In the normal pipeline
# both CPA and New API must be configured; employee traffic goes to New API.
AI_OPS_GATEWAY_NEW_API_BASE_URL=http://127.0.0.1:3000/v1
AI_OPS_GATEWAY_NEW_API_API_KEY=
# CPA's OpenAI-compatible account-pool endpoint.
# When AI OPS runs in Docker and CPA runs on Windows, use
# http://host.docker.internal:8317/v1 instead of 127.0.0.1.
AI_OPS_GATEWAY_CPA_BASE_URL=
AI_OPS_GATEWAY_CPA_API_KEY=
# Codex/Responses requests may be long-lived; default CPA timeout is 180s.
AI_OPS_GATEWAY_TIMEOUT_MS=180000
AI_OPS_GATEWAY_DEFAULT_MODEL=
# Optional non-streaming fallback model. It is only used for timeout, rate-limit, or availability errors.
AI_OPS_GATEWAY_FALLBACK_MODEL=
# Keep false until the fallback model has been explicitly verified.
AI_OPS_GATEWAY_ALLOW_FALLBACK=false
# Legacy compatibility credential; leave blank after database-backed AI OPS Keys are provisioned.
AI_OPS_GATEWAY_CLIENT_API_KEY=
# Map AI OPS business aliases to IDs returned by CPA /v1/models, for example
# ecommerce-general=gpt-5-codex,ecommerce-copy=gpt-5-codex.
AI_OPS_GATEWAY_MODEL_ALIASES=

# CPA connection and management credentials are read automatically by the BFF;
# the browser never receives these values or OAuth files.
CPA_MANAGEMENT_URL=http://127.0.0.1:8317/management.html
CPA_MANAGEMENT_KEY=
