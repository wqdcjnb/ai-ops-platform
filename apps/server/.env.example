# New API is probed on the server only. Never expose these values to the browser.
NEW_API_BASE_URL=http://127.0.0.1:3000

# Optional management credential. Leave blank to report connectivity only.
NEW_API_ACCESS_TOKEN=

# Optional compatibility header for older New API deployments.
NEW_API_USER_ID=

# Authentication is required by default. Use disabled only for isolated contract tests.
AUTH_MODE=required
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-this-admin-password
AUTH_ADMIN_DISPLAY_NAME=超级管理员
AUTH_EMPLOYEE_USERNAME=employee
AUTH_EMPLOYEE_PASSWORD=change-this-employee-password
AUTH_EMPLOYEE_DISPLAY_NAME=林筱雨

# SQLite path. Leave blank to use data/platform.sqlite under the server workspace.
PLATFORM_DB_PATH=
