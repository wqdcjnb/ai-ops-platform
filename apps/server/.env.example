# Copy this file to apps/server/.env.local. It is ignored by Git.
# Employee requests always enter the managed relay gateway. Do not put a
# third-party relay URL or API key in this file: add those in 第三方账号管理.

HOST=127.0.0.1
PORT=4175
AUTH_MODE=required
AUTH_ADMIN_USERNAME=admin@aiops.local
AUTH_ADMIN_PASSWORD=change-this-local-admin-password
AUTH_ADMIN_DISPLAY_NAME=超级管理员

# Leave blank to use data/platform.sqlite under the server workspace.
PLATFORM_DB_PATH=
# Use stable, unique local values before production use. Neither belongs in Git.
AI_OPS_KEY_ENCRYPTION_SECRET=
AI_OPS_AUDIT_ENCRYPTION_SECRET=

# The address placed in the employee's Codex / WorkBuddy import package.
AI_OPS_PUBLIC_GATEWAY_BASE_URL=http://127.0.0.1:4175

# The only accepted data-plane mode. Third-party credentials are encrypted in
# the server-side registry, not process environment variables.
AI_OPS_GATEWAY_MODE=relay
AI_OPS_GATEWAY_TIMEOUT_MS=60000
AI_OPS_GATEWAY_DEFAULT_STREAMING=false
AI_OPS_CONTEXT_OPTIMIZATION_ENABLED=true
AI_OPS_CONTEXT_MAX_INPUT_CHARS=48000
AI_OPS_CONTEXT_MAX_MESSAGES=24
# Number of concurrent lightweight /models probes when health is stale.
# Valid effective range: 2–8; default: 3.
AI_OPS_RELAY_PROBE_FANOUT=3

# Optional comma-separated restriction for third-party service hostnames.
# Leave blank to let the administrator connect public HTTPS services directly.
# When set, only exact names on this list are accepted; use * to keep custom
# public hosts enabled. Private/local addresses are always blocked except for
# the explicit development loopback setting below.
AI_OPS_EXTERNAL_PROVIDER_ALLOWED_HOSTS=
# Persistent encrypted third-party-account registry. Defaults beside the DB.
AI_OPS_EXTERNAL_PROVIDERS_FILE=
# Development only: permits HTTP for localhost/127.0.0.1/::1.
AI_OPS_ALLOW_INSECURE_EXTERNAL_PROVIDER=false
